# Copia este archivo a .env y completa los dos valores obligatorios.
OPENROUTER_API_KEY=
# Identificador proveedor/modelo del catálogo de OpenRouter.
OPENROUTER_MODEL=

AI_SYSTEM_PROMPT="Eres un asistente útil. Responde en español de forma clara y concisa."
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=512
# Se configura en milisegundos y se convierte a segundos para el cliente HTTP.
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
